    "@vue/compiler-sfc": "3.5.38",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.3"
  }
